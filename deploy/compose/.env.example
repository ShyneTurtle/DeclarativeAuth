# For the full list of DECLARATIVEAUTH_* variables, their defaults, and
# descriptions, see examples/.env.example.

# CHANGE THIS
POSTGRES_PASSWORD=your_postgres_password # CHANGE ME
# CHANGE THIS

POSTGRES_USER=declarativeauth
POSTGRES_DB=declarativeauth
DECLARATIVEAUTH_DATABASE_DSN=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?sslmode=disable # CHANGE THIS

# Change these to match how you (and anything doing LDAP/OIDC against this
# instance) actually reach it -- e.g. your homelab's domain/hostname, or a
# LAN-only hostname if this never leaves your network.
DECLARATIVEAUTH_OIDC_ISSUER=https://auth.home.example
DECLARATIVEAUTH_LDAP_BASE_DN=dc=home,dc=example

# TLS on by default -- self-signed unless you drop real certs into ./tls
# (see docker-compose.yaml) and uncomment the two lines below.
DECLARATIVEAUTH_LDAP_SECURE_LISTEN_ADDR=0.0.0.0:636
DECLARATIVEAUTH_OIDC_SECURE_LISTEN_ADDR=0.0.0.0:8443
# DECLARATIVEAUTH_TLS_CERT_FILE=/etc/declarativeauth/tls/cert.pem
# DECLARATIVEAUTH_TLS_KEY_FILE=/etc/declarativeauth/tls/key.pem

# Your real SMTP relay -- password resets and MFA codes won't send without
# one (there's no mailcatcher in this stack, unlike deploy/demo/).
DECLARATIVEAUTH_SMTP_HOST=smtp.example.com
DECLARATIVEAUTH_SMTP_PORT=587
DECLARATIVEAUTH_SMTP_USERNAME=
DECLARATIVEAUTH_SMTP_PASSWORD=
DECLARATIVEAUTH_SMTP_FROM=DeclarativeAuth <notifications@home.example>

# Safe here only because this stack always runs a single instance: lets you
# edit users.yaml/groups.yaml (bind-mounted from ./identity) straight from
# /admin instead of hand-editing files on the host every time.
DECLARATIVEAUTH_ADMIN_UI_CONFIG_EDITOR_ENABLED=true
