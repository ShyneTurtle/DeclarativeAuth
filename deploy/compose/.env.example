# Env file for deploy/compose/docker-compose.yaml. Copy to `.env` in this
# same directory (docker compose auto-loads it from there) and adjust as
# needed:
#
#   cp deploy/compose/.env.example deploy/compose/.env
#
# This is a minimal, compose-stack-specific subset -- for the full list of
# DECLARATIVEAUTH_* variables, their defaults, and descriptions, see
# examples/.env.example.

DECLARATIVEAUTH_DATABASE_DSN=postgres://declarativeauth:declarativeauth@postgres:5432/declarativeauth?sslmode=disable
DECLARATIVEAUTH_PASSWORD_PEPPER=dev-only-pepper-do-not-use-in-prod

DECLARATIVEAUTH_OIDC_ISSUER=http://localhost:8080
DECLARATIVEAUTH_LDAP_BASE_DN=dc=example,dc=com

DECLARATIVEAUTH_IDENTITY_PATH=/etc/declarativeauth/identity

# mailcatcher, the compose service name, catches every outgoing email
# without actually delivering it -- view them at http://localhost:1080
# while the stack is running.
DECLARATIVEAUTH_SMTP_HOST=mailcatcher
DECLARATIVEAUTH_SMTP_PORT=1025
DECLARATIVEAUTH_SMTP_FROM=DeclarativeAuth <notifications@example.com>

# Safe here only because this stack always runs a single instance.
DECLARATIVEAUTH_ADMIN_UI_CONFIG_EDITOR_ENABLED=true
