# Full reference for DeclarativeAuth's runtime configuration: every
# DECLARATIVEAUTH_* environment variable.

# ---- Logging -----------------------------------------------------------
# Default: info
# DECLARATIVEAUTH_LOG_LEVEL=info # debug | info | warn | error
# Default: json
# DECLARATIVEAUTH_LOG_FORMAT=json # json | text

# ---- PASSWORD POLICY -----------------------------------------------------
# Default: 8
# DECLARATIVEAUTH_PASSWORD_POLICY_MIN_LENGTH=8
# Default: 2, set to 0 to disable strength checks entirely, recommended 4.
# DECLARATIVEAUTH_PASSWORD_POLICY_MIN_STRENGTH=2 # 0-4 (0=very weak, 1=weak, 2=fair, 3=good, 4=strong)

# ---- Database ------------------------------------------------------------
DB_USER=declarativeauth
DB_PASSWORD=declarativeauth # CHANGE THIS
DB_NAME=declarativeauth

# Database connection string
DECLARATIVEAUTH_DATABASE_DSN=postgres://${DB_USER}:${DB_PASSWORD}@localhost:5432/${DB_NAME}?sslmode=disable
# Default: 10
# DECLARATIVEAUTH_DATABASE_MAX_CONNS=10
# Default: 5s
# DECLARATIVEAUTH_DATABASE_CONNECT_TIMEOUT=5s

# ---- LDAP ------------------------------------------------------------------
# Required: the LDAP base domain name (DN), where the directory entries are located.
DECLARATIVEAUTH_LDAP_BASE_DN=dc=example,dc=com
# Default: false, uncomment to allow anonymous binds (no username/password).
# DECLARATIVEAUTH_LDAP_ALLOW_ANONYMOUS_BIND=true

# Uncomment to enable the unsecure LDAP listener (plain LDAP, no TLS).
# DECLARATIVEAUTH_LDAP_LISTEN_ADDR=0.0.0.0:389

# Comment to disable the secure LDAP listener (LDAPS, TLS-terminating).
DECLARATIVEAUTH_LDAP_SECURE_LISTEN_ADDR=0.0.0.0:636
# Optional per-listener cert/key path. If unset, falls back to the shared
# "DECLARATIVEAUTH_TLS_CERT_FILE/KEY_FILE" vars, then to a self-signed certificate.
# DECLARATIVEAUTH_LDAP_TLS_CERT_FILE=
# DECLARATIVEAUTH_LDAP_TLS_KEY_FILE=

# ---- OIDC / web ----------------------------------------------------------
# (required if OIDC enabled) Must exactly match the externally-visible base URL
# clients use; it's embedded in issued tokens and the discovery document.
DECLARATIVEAUTH_OIDC_ISSUER=https://localhost:8443

# Uncomment to enable the INSECURE OIDC and web interfaces (plain HTTP, no TLS).
# DECLARATIVEAUTH_OIDC_LISTEN_ADDR=0.0.0.0:8080

# Comment to disable the OIDC and web secure interfaces (TLS terminating).
DECLARATIVEAUTH_OIDC_SECURE_LISTEN_ADDR=0.0.0.0:8443
# Optional per-listener cert/key path. If unset, falls back to the shared
# "DECLARATIVEAUTH_TLS_CERT_FILE/KEY_FILE" vars, then to a self-signed certificate.
# DECLARATIVEAUTH_OIDC_TLS_CERT_FILE=
# DECLARATIVEAUTH_OIDC_TLS_KEY_FILE=

# DEPRECATED: Will be removed in a future release.
# JSON array of statically declared OIDC relying parties (no dynamic client
# registration). Empty/unset means no OIDC clients are registered.
# Example:
#   DECLARATIVEAUTH_OIDC_CLIENTS=[{"clientID":"example-client","redirectURIs":["http://localhost:9000/callback"],"public":true}]
# public: true = public client (SPA/mobile; PKCE required, no secret).
# public: false = confidential client -- also set "clientSecret".
DECLARATIVEAUTH_OIDC_CLIENTS=[]

# ---- SMTP ------------------------------------------------------------------
# Required for sending email notifications (password resets, 2FA codes, etc.).
DECLARATIVEAUTH_SMTP_HOST=localhost
# Typically 587 (STARTTLS), 25 (INSECURE), or 465 (implicit TLS, don't forget to set the env var DECLARATIVEAUTH_SMTP_IMPLICIT_TLS=true).
DECLARATIVEAUTH_SMTP_PORT=25
# Default: false, Uncomment to enable implicit TLS (SMTPS) on connect (for port 465 typically).
# DECLARATIVEAUTH_SMTP_IMPLICIT_TLS=true
# Default: false, Uncomment to skip TLS certificate verification (for self-signed certs).
# DECLARATIVEAUTH_SMTP_INSECURE_SKIP_VERIFY=true

# Optional username/password for SMTP auth. If the relay doesn't require auth, leave these blank.
DECLARATIVEAUTH_SMTP_USERNAME=
DECLARATIVEAUTH_SMTP_PASSWORD=

# Optional "from" address for outgoing email. If unset, the SMTP server's default is used.
DECLARATIVEAUTH_SMTP_FROM=DeclarativeAuth <notifications@example.com>
# Optional HELO/EHLO domain to send to the SMTP server. If unset, localhost is used.
# DECLARATIVEAUTH_SMTP_HELO_DOMAIN=

# Default: 10s
# DECLARATIVEAUTH_SMTP_TIMEOUT=10s

# ---- Metrics ---------------------------------------------------------------
# Uncomment to enable Prometheus metrics.
# DECLARATIVEAUTH_METRICS_LISTEN_ADDR=0.0.0.0:9090

# ---- Declarative identity --------------------------------------------------
# Default: /etc/declarativeauth/identity, Path to the directory containing users.yaml & groups.yaml
# DECLARATIVEAUTH_IDENTITY_PATH=/etc/declarativeauth/identity

# Default: 500ms, avoids multiple reloads when editing multiple files (eg. config upload).
# DECLARATIVEAUTH_IDENTITY_RELOAD_DEBOUNCE=500ms

# ---- Network / reverse proxy -----------------------------------------------
# Optional, comma-separated CIDR ranges of reverse proxies/load balancers you trust
# to report the real client IP/scheme via X-Forwarded-For / X-Forwarded-Proto.
# Only the immediate TCP peer is checked against this list.
# DECLARATIVEAUTH_NETWORK_TRUSTED_PROXIES=

# Trusts the process's own default gateway, on top of TRUSTED_PROXIES above.
# In Docker/Kubernetes this is typically the bridge/overlay network gateway.
# Default: true, Uncomment if DeclarativeAuth is reachable directly (no proxy).
# DECLARATIVEAUTH_NETWORK_TRUST_DEFAULT_GATEWAY=false

# ---- Brute-force backoff ---------------------------------------------------
# Persisted in Postgres, shared across LDAP and OIDC/web login attempts, and
# keyed by both username and source IP. After THRESHOLD failed attempts,
# each further attempt is delayed, doubling from BACKOFF_BASE up
# to BACKOFF_MAX, until WINDOW has elapsed since the last failure (which
# resets the counter).

# Default: 5
# DECLARATIVEAUTH_RATE_LIMIT_THRESHOLD=5

# Default: 1s
# DECLARATIVEAUTH_RATE_LIMIT_BACKOFF_BASE=1s

# Default: 15m
# DECLARATIVEAUTH_RATE_LIMIT_BACKOFF_MAX=15m

# Default: 24h
# DECLARATIVEAUTH_RATE_LIMIT_WINDOW=24h

# ---- Admin UI ----------------------------------------------------------
# Serves a small gated page under /admin: SMTP test, group-inheritance
# graph, and optionally a config editor (see below).
DECLARATIVEAUTH_ADMIN_UI_ENABLED=true
# Members of this declarative group (defined in groups.yaml) can reach /admin.
DECLARATIVEAUTH_ADMIN_UI_ADMIN_GROUP=admins

# Lets an admin edit and save users.yaml/groups.yaml straight
# from the browser, with live validation before saving. Only turn this on for a
# single-instance deployment writing to local disk. Otherwise, leave this false
# (a save here wouldn't propagate to other replicas) and edit the declarative 
# files through your normal deployment pipeline instead.
# Default: false, uncomment to enable the config editor.
# DECLARATIVEAUTH_ADMIN_UI_CONFIG_EDITOR_ENABLED=true

# ---- Shared TLS settings ----------------------------------------------------
# Optional shared certificate (LDAPS & web), can be overriden for each listener.
# If unset, a self-signed certificate is generated instead (avoid in prod).

# Cert file path
# DECLARATIVEAUTH_TLS_CERT_FILE=
# Private key file path
# DECLARATIVEAUTH_TLS_KEY_FILE=

# Default: 1.2, minimum TLS version to accept for incoming TLS connections.
# DECLARATIVEAUTH_TLS_MIN_VERSION=1.2 # 1.2 or 1.3

# ---- Passkeys (WebAuthn) ----------------------------------------------------
# Lets users register and log in with passkeys (fingerprint/face/security
# key/password manager). Browsers enforce WebAuthn only works on secure pages,
# so this is harmless to leave on even without TLS.

# Default: true, uncomment to disable passkeys.
# DECLARATIVEAUTH_WEBAUTHN_ENABLED=false

# The Relying Party ID -- the effective domain passkeys are scoped to (e.g.
# "auth.example.com", no scheme or port). Defaults to the hostname of
# DECLARATIVEAUTH_OIDC_ISSUER; only set this explicitly if passkeys need to
# be scoped to a different (e.g. broader parent) domain than the issuer.
# DECLARATIVEAUTH_WEBAUTHN_RP_ID=

# Comma-separated fully qualified origins (scheme+host+port) permitted to
# complete a passkey ceremony. Defaults to DECLARATIVEAUTH_OIDC_ISSUER.
# DECLARATIVEAUTH_WEBAUTHN_RP_ORIGINS=

# Human-readable name shown by the browser/OS passkey UI.
# Default: DeclarativeAuth
# DECLARATIVEAUTH_WEBAUTHN_RP_DISPLAY_NAME=DeclarativeAuth
