# Full reference for DeclarativeAuth's runtime configuration: every
# DECLARATIVEAUTH_* environment variable `declarativeauth serve` reads,
# its default, and whether it's required. There is no config FILE --
# this project is configured entirely through the environment (12-factor
# style). The one exception is the declarative identity itself
# (users.yaml/groups.yaml, pointed to by DECLARATIVEAUTH_IDENTITY_PATH
# below) -- that's a deliberately different kind of input ("who exists",
# hot-reloaded) from this file ("how the process runs", set once at
# startup). See examples/identity/ for a worked identity example.
#
# Copy this file to `.env` and fill in the values marked (required); every
# other variable falls back to the default shown if unset or empty.
#
#   cp .env.example .env
#
# How you actually get these into the process's environment depends on
# your deployment: `docker run --env-file .env`, a Kubernetes Secret (see
# deploy/kubernetes/secret-example.yaml), a systemd EnvironmentFile=, or
# just `export $(grep -v '^#' .env | xargs)` for a bare-metal run. The
# docker-compose quickstart (deploy/compose/) has its own smaller
# .env.example tailored to that stack's service names.

# ---- Logging -----------------------------------------------------------
DECLARATIVEAUTH_LOG_LEVEL=info
# debug | info | warn | error
DECLARATIVEAUTH_LOG_FORMAT=json
# json | text -- use "text" for readable local-dev logs

# ---- Database ------------------------------------------------------------
# (required) Postgres connection string. Postgres is DeclarativeAuth's only
# stateful dependency: it stores password hashes, sessions, password-reset
# tokens, audit log, and brute-force lockout counters. It does NOT store
# users/groups -- that's what the identity files are for.
DECLARATIVEAUTH_DATABASE_DSN=postgres://declarativeauth:declarativeauth@localhost:5432/declarativeauth?sslmode=disable
DECLARATIVEAUTH_DATABASE_MAX_CONNS=10
DECLARATIVEAUTH_DATABASE_CONNECT_TIMEOUT=5s

# ---- Password hashing ------------------------------------------------------
# (required) Server-side secret mixed into every password hash via
# HMAC-SHA256, on top of each password's own random salt, before Argon2id
# hashing. Unlike every other secret below, this is NOT a config field with
# a configurable env-var name -- it's always exactly this variable, so
# there's exactly one place to look for it.
# Generate one with: openssl rand -base64 32
DECLARATIVEAUTH_PASSWORD_PEPPER=

DECLARATIVEAUTH_PASSWORD_POLICY_MIN_LENGTH=8
DECLARATIVEAUTH_PASSWORD_POLICY_MIN_STRENGTH=2
# 0-4 (0=very weak, 1=weak, 2=fair, 3=good, 4=strong), the same scale shown
# by the live strength bar on the set-password page.

# ---- LDAP ------------------------------------------------------------------
DECLARATIVEAUTH_LDAP_LISTEN_ADDR=0.0.0.0:389
# Use :636 if this listener terminates LDAPS itself (see LDAP_TLS_ENABLED).
DECLARATIVEAUTH_LDAP_BASE_DN=dc=example,dc=com
# Users appear as uid=<username>,ou=users,<baseDN>; groups as cn=<name>,ou=groups,<baseDN>.
DECLARATIVEAUTH_LDAP_ALLOW_ANONYMOUS_BIND=false
DECLARATIVEAUTH_LDAP_TLS_ENABLED=false
# true = DeclarativeAuth terminates LDAPS itself. false = plain LDAP; put a
# TLS-terminating proxy in front instead (see README's TLS section).
DECLARATIVEAUTH_LDAP_TLS_CERT_FILE=
DECLARATIVEAUTH_LDAP_TLS_KEY_FILE=
# Optional per-listener cert/key. If unset while TLS_ENABLED=true, falls
# back to DECLARATIVEAUTH_TLS_CERT_FILE/KEY_FILE below, then to an
# ephemeral self-signed dev-only certificate.

# ---- OIDC / web ----------------------------------------------------------
# (required) Must exactly match the externally-visible base URL clients
# use; it's embedded in issued tokens and the discovery document.
DECLARATIVEAUTH_OIDC_ISSUER=http://localhost:8080
DECLARATIVEAUTH_OIDC_LISTEN_ADDR=0.0.0.0:8080
# Serves OIDC endpoints, the login/reset web pages, and the admin UI, all
# on one HTTP(S) listener.
DECLARATIVEAUTH_OIDC_TLS_ENABLED=false
DECLARATIVEAUTH_OIDC_TLS_CERT_FILE=
DECLARATIVEAUTH_OIDC_TLS_KEY_FILE=
# JSON array of statically declared OIDC relying parties (no dynamic client
# registration). Empty/unset means no OIDC clients are registered.
# Example:
#   DECLARATIVEAUTH_OIDC_CLIENTS=[{"clientID":"example-client","redirectURIs":["http://localhost:9000/callback"],"public":true}]
# public: true = public client (SPA/mobile; PKCE required, no secret).
# public: false = confidential client -- also set "clientSecret".
DECLARATIVEAUTH_OIDC_CLIENTS=[]

# ---- SMTP ------------------------------------------------------------------
# Used to send password-reset and account-setup emails.
DECLARATIVEAUTH_SMTP_HOST=
DECLARATIVEAUTH_SMTP_PORT=
# Typically 587 (STARTTLS), 465 (implicit TLS), or 25.
DECLARATIVEAUTH_SMTP_USERNAME=
DECLARATIVEAUTH_SMTP_PASSWORD=
# Leave USERNAME/PASSWORD blank for relays that don't require auth (e.g. a
# local mailcatcher/MailHog instance for development).
DECLARATIVEAUTH_SMTP_FROM=DeclarativeAuth <notifications@example.com>

# ---- Metrics ---------------------------------------------------------------
DECLARATIVEAUTH_METRICS_LISTEN_ADDR=0.0.0.0:9090
# Prometheus metrics served at /metrics on this address.

# ---- Declarative identity --------------------------------------------------
# (required) Directory containing users.yaml/groups.yaml (or the split form
# users.d/*.yaml, groups.d/*.yaml). See examples/identity/ for a worked
# example with diamond group inheritance. Changes under this path are
# picked up automatically via a filesystem watcher -- no restart needed.
DECLARATIVEAUTH_IDENTITY_PATH=/etc/declarativeauth/identity
DECLARATIVEAUTH_IDENTITY_RELOAD_DEBOUNCE=500ms
# Delay after a file-change event before reloading, to coalesce rapid
# successive writes (e.g. an editor's save-as-temp-then-rename).

# ---- Network / reverse proxy -----------------------------------------------
# Comma-separated CIDR ranges of reverse proxies/load balancers you trust
# to report the real client IP/scheme via X-Forwarded-For /
# X-Forwarded-Proto. Only the immediate TCP peer is checked against this
# list -- if it matches, those headers are trusted for rate-limiting /
# audit-logging IPs and for detecting HTTPS termination upstream.
DECLARATIVEAUTH_NETWORK_TRUSTED_PROXIES=
# e.g. DECLARATIVEAUTH_NETWORK_TRUSTED_PROXIES=10.0.0.0/8,192.168.1.0/24
DECLARATIVEAUTH_NETWORK_TRUST_DEFAULT_GATEWAY=true
# When true (the default), the process's own default gateway is also
# trusted, on top of TRUSTED_PROXIES above. In Docker/Kubernetes this is
# typically the bridge/overlay network gateway -- the address a
# host-level reverse proxy or sidecar talks to the container through --
# so forwarded headers work out of the box without hardcoding a
# Docker-assigned address that can differ per host or restart. Set to
# false if DeclarativeAuth is reachable directly, with no proxy in front.

# ---- Brute-force backoff ---------------------------------------------------
# Persisted in Postgres, shared across LDAP bind and OIDC/web login
# attempts, keyed by both username and source IP. After THRESHOLD failed
# attempts, each further attempt is delayed, doubling from BACKOFF_BASE up
# to BACKOFF_MAX, until WINDOW has elapsed since the last failure (which
# resets the counter).
DECLARATIVEAUTH_RATE_LIMIT_THRESHOLD=5
DECLARATIVEAUTH_RATE_LIMIT_BACKOFF_BASE=1s
DECLARATIVEAUTH_RATE_LIMIT_BACKOFF_MAX=15m
DECLARATIVEAUTH_RATE_LIMIT_WINDOW=24h

# ---- Admin UI ----------------------------------------------------------
DECLARATIVEAUTH_ADMIN_UI_ENABLED=true
# Serves a small gated page under /admin: SMTP test, group-inheritance
# graph, and optionally a config editor (see below).
DECLARATIVEAUTH_ADMIN_UI_ADMIN_GROUP=admins
# Members of this declarative group (defined in groups.yaml) can reach /admin.
DECLARATIVEAUTH_ADMIN_UI_CONFIG_EDITOR_ENABLED=false
# Lets an admin edit and save users.yaml/groups.yaml straight from the
# browser, with live validation before saving. Only turn this on for a
# single-instance deployment writing to local disk -- on a multi-node or
# GitOps-managed deployment, leave this false (a save here wouldn't
# propagate to other replicas) and edit the declarative files through your
# normal deployment pipeline instead.

# ---- Shared TLS fallback ----------------------------------------------------
# Optional shared certificate, used as the fallback cert/key pair for any
# listener above that has TLS_ENABLED=true but no cert/key of its own. If a
# listener needs TLS and neither this nor a listener-specific cert/key is
# set, a self-signed, dev-only certificate is generated instead (a warning
# is logged when that happens -- don't rely on it in production).
DECLARATIVEAUTH_TLS_CERT_FILE=
DECLARATIVEAUTH_TLS_KEY_FILE=
DECLARATIVEAUTH_TLS_MIN_VERSION=1.2
# "1.2" or "1.3"
